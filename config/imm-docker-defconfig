# ImmortalWrt (IMM) rootfs for Docker -- universal aarch64 / arm64
#
# Target: armsr/armv8  -- generic ARMv8 (aarch64) SystemReady platform.
#   容器与宿主(arm64)共用内核 => 不需要板级 dtb / u-boot / WiFi 驱动 / 物理网卡驱动。
#   armsr/armv8 是任何 arm64 设备都能跑的通用目标，不绑定具体板子。
#
# Output: immortalwrt-armsr-armv8-generic-rootfs.tar.gz  (docker import 即可用)
#
# 用法: cp config/imm-docker-defconfig .config && make defconfig && make -j$(nproc)

# ---------------------------------------------------------------- target
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_DEVICE_generic=y
CONFIG_TARGET_PROFILE="DEVICE_generic"

# rootfs tarball —— 本项目的核心产物
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_IMAGES_GZIP=y

# 容器不需要 squashfs 只读镜像（省一半镜像构建时间）；ext4 保留走官方默认路径
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set

# ================================================================
#  科学上网
# ================================================================
# OpenClash 真实依赖（已核对其 Makefile）：
#   luci-compat + dnsmasq-full + bash + curl + ca-bundle + ip-full
#   + ruby + ruby-yaml + kmod-inet-diag + kmod-nft-tproxy + kmod-tun + unzip
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_unzip=y

# ================================================================
#  LuCI 完整路由系统
# ================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_LUCI_LANG_zh_Hans=y

# 终端（Web 里直接开 shell，容器运维刚需）
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y

# 网络核心（OpenClash 的 nft/ipset 规则依赖这些）
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_ip-full=y

# 路由附加功能（容器内可用，保留）
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y

# ================================================================
#  工具链
# ================================================================
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_coreutils-stat=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_dropbear=y

# ================================================================
#  已排除 —— 容器环境用不上（每条都有明确理由）
# ================================================================
#
# [1] Docker-in-Docker：容器里再跑 docker 毫无意义，且 dockerd 是 Go 编译，
#     是整个构建最慢的一块（可省 20~30 分钟）
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_docker-compose is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
#
# [2] 块设备 / 文件系统工具：容器内没有独立块设备，分区、格式化、挂载全由宿主完成
# CONFIG_PACKAGE_parted is not set
# CONFIG_PACKAGE_lsblk is not set
# CONFIG_PACKAGE_block-mount is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
#
# [3] 物理网卡驱动：由 armsr 目标的 DEVICE_PACKAGES 默认带入 ~25 个
#     （kmod-e1000e / vmxnet3 / dwmac-rockchip / mvneta / sfp / phy-* ...），
#     容器共用宿主网络栈，这些一个都用不到 —— 工作流里会 patch 掉
#     target/linux/armsr/image/Makefile 的 DEVICE_PACKAGES
#
# [4] WiFi：按要求不带
# CONFIG_PACKAGE_kmod-mt7915e is not set
# CONFIG_PACKAGE_kmod-mt7916-firmware is not set
# CONFIG_PACKAGE_wpad-openssl is not set
#
# [5] LEDE 专有包，IMM 仓库中不存在（写了必然构建失败）
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-partexp is not set
